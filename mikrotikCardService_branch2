const { RouterOSClient } = require("routeros-client");

const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

// ذاكرة مؤقتة خاصة بمعاملات الفرع الثاني لمنع التكرار
const processedTransactionsBranch2 = new Set();

// تنظيف دوري للذاكرة كل ساعة لمنع تراكم البيانات
setInterval(() => {
  if (processedTransactionsBranch2.size > 5000) {
    processedTransactionsBranch2.clear();
  }
}, 60 * 60 * 1000);

function generateCardCode(prefix, randomLength = 8) {
  const chars = "0123456789";
  let result = prefix;
  for (let i = 0; i < randomLength; i++) {
    result += chars.charAt(Math.floor(Math.random() * chars.length));
  }
  return result;
}

/**
 * 1. إنشاء الكارت في اليوزر مانجر (الفرع الثاني) مع فحص التشابه والتكرار
 */
async function createCardOnlyBranch2(routerConfig, prefix, transactionId = "") {
  let cardCode = "";
  let isCreated = false;
  let attempts = 0;
  const maxAttempts = 10;

  while (!isCreated && attempts < maxAttempts) {
    attempts++;
    cardCode = generateCardCode(prefix);

    const client = new RouterOSClient({
      host: routerConfig.host,
      user: routerConfig.user,
      password: routerConfig.password,
      port: routerConfig.port,
      timeout: 25
    });

    try {
      const conn = await client.connect();
      console.log(`🧪 [فرع 2 - اختبار] محاولة إنشاء كارت جديد (محاولة ${attempts}): ${cardCode} على سيرفر الفرع الثاني: ${routerConfig.host} (معاملة: ${transactionId})`);

      // إضافة المستخدم في اليوزر مانجر للفرع الثاني
      await conn.menu("/tool/user-manager/user").add({
        username: cardCode,
        password: cardCode,
        customer: "admin"
      });

      await client.close().catch(() => {});
      isCreated = true;
      console.log(`✅ [فرع 2] تم إنشاء الكارت بنظافة ودون تشابه: ${cardCode}`);

    } catch (error) {
      if (client) await client.close().catch(() => {});
      const errStr = error.message || "";
      
      // إذا كان الكارت مكرراً أو موجوداً مسبقاً، نتجاهله ونولد رقماً جديداً نظيفاً
      if (errStr.includes("already exists") || errStr.includes("such username already exists")) {
        console.warn(`⚠️ [فرع 2] الكود ${cardCode} موجود مسبقاً، جاري توليد رقم جديد تفادياً لأي تكرار...`);
        continue;
      } else {
        throw error;
      }
    }
  }

  if (!isCreated) {
    throw new Error("[فرع 2] فشل توليد كود فريد وغير مكرر بعد عدة محاولات.");
  }

  return cardCode;
}

/**
 * 2. تفعيل الباقة (البروفايل) عبر تحديث وتشغيل السكريبت في ميكروتيك الفرع الثاني
 */
async function activateCardProfileViaScriptBranch2(routerConfig, cardCode, profileName, delaySeconds = 10, maxRetries = 3) {
  console.log(`⏳ [فرع 2 - انتظار] الانتظار لمدة ${delaySeconds} ثوانٍ لضمان استقرار الكارت (${cardCode}) للباقة (${profileName})...`);
  await sleep(delaySeconds * 1000);

  let attempt = 0;
  let success = false;
  let lastError = null;

  while (attempt < maxRetries && !success) {
    attempt++;
    
    const client = new RouterOSClient({
      host: routerConfig.host,
      user: routerConfig.user,
      password: routerConfig.password,
      port: routerConfig.port,
      timeout: 15
    });

    try {
      console.log(`🔄 [فرع 2 - محاولة ${attempt}/${maxRetries}] الاتصال بسيرفر الفرع الثاني (${routerConfig.host}) لتفعيل الكارت: ${cardCode} بالبروفايل: ${profileName}`);
      const api = await client.connect();
      console.log(`✅ [فرع 2 - MikroTik] تم الاتصال بالسيرفر بنجاح`);

      const scriptMenu = api.menu('/system/script');

      // تصميم محتوى السكريبت ديناميكياً للفرع الثاني
      const updatedSource = `:local cardName "${cardCode}";\n` +
                            `:local cardProfile "${profileName}";\n` +
                            `\n` +
                            `# Activate user profile in User Manager (Branch 2)\n` +
                            `/tool user-manager user create-and-activate-profile user=$cardName profile=$cardProfile customer=admin;\n` +
                            `\n` +
                            `:log warning ("Branch 2: activated profile (" . $cardProfile . ") for card: " . $cardName);`;

      // أ. تحديث محتوى السكريبت في الميكروتيك للفرع الثاني
      await scriptMenu.where('name', 'activate_profile_script').set({
        source: updatedSource
      });
      console.log(`📝 [فرع 2 - MikroTik] تم تحديث السكريبت بالكارت: ${cardCode} والبروفايل: ${profileName}`);

      // ب. تشغيل السكريبت
      await scriptMenu.exec('run', { number: 'activate_profile_script' });
      console.log(`🚀 [فرع 2 - MikroTik] تم تشغيل السكريبت بنجاح للكارت: ${cardCode}`);

      await client.close().catch(() => {});
      console.log(`🎉 [فرع 2 - نجاح تام] تم تفعيل البروفايل (${profileName}) للكارت (${cardCode}) في المحاولة ${attempt}!`);
      success = true;
      return true;

    } catch (error) {
      lastError = error;
      console.error(`❌ [فرع 2 - خطأ في المحاولة ${attempt}] فشل تفعيل الكارت "${cardCode}" مع البروفايل "${profileName}":`, error.message || error);
      
      try {
        await client.close();
      } catch (e) {}

      if (attempt < maxRetries) {
        const waitTime = attempt * 3;
        console.log(`⏳ [فرع 2] الانتظار لمدة ${waitTime} ثوانٍ قبل إعادة المحاولة...`);
        await sleep(waitTime * 1000);
      }
    }
  }

  console.error(`🚨 [فرع 2 - فشل نهائي] الكارت: ${cardCode} | البروفايل المطلوب: ${profileName} | الخطأ الأخير: ${lastError ? lastError.message : "غير معروف"}`);

  throw new Error(
    `[فرع 2] فشل تشغيل سكريبت البروفايل للكارت (${cardCode}) بروفايل (${profileName}) بعد ${maxRetries} محاولات. السبب: ${lastError ? lastError.message : "خطأ غير معروف"}`
  );
}

/**
 * 3. الدالة الرئيسية للفرع الثاني مع الحماية التامة ضد التكرار لكل رقم معاملة دفع
 */
async function processPaymentAndCreateCardBranch2(routerConfig, prefix, profileName, transactionId = "", delaySeconds = 10) {
  if (!transactionId || transactionId === "undefined" || transactionId === "null") {
    console.warn("⚠️ [فرع 2] تحذير: تم استدعاء دالة إنشاء الكارت بدون رقم معاملة حقيقي (transactionId).");
  } else {
    // التحقق مما إذا كانت المعاملة قد عולجت مسبقاً في الفرع الثاني
    if (processedTransactionsBranch2.has(String(transactionId))) {
      console.warn(`🛑 [فرع 2 - حماية التكرار] المعاملة برقم (${transactionId}) تمت معالجتها مسبقاً وتم إصدار كارت لها. تم منع إصدار كارت مكرر.`);
      throw new Error(`Duplicate transaction prevented for Branch 2: ${transactionId}`);
    }
  }

  try {
    console.log(`🚀 [فرع 2] بدء عملية إصدار الكارت وتفعيله بعد الدفع للمعاملة: ${transactionId}`);
    
    // الخطوة الأولى: إنشاء الكارت للفرع الثاني
    const cardCode = await createCardOnlyBranch2(routerConfig, prefix, transactionId);

    // الخطوة الثانية: تفعيل البروفايل عبر السكريبت للفرع الثاني
    await activateCardProfileViaScriptBranch2(routerConfig, cardCode, profileName, delaySeconds);

    // تسجيل المعاملة في ذاكرة الفرع الثاني لعدم تكرارها نهائياً
    if (transactionId) {
      processedTransactionsBranch2.add(String(transactionId));
    }

    console.log(`✨ [فرع 2] تمت العملية بنجاح كامل للكارت: ${cardCode} بالبروفايل: ${profileName}`);
    return {
      success: true,
      cardCode: cardCode,
      profileName: profileName
    };

  } catch (error) {
    console.error(`❌ [فرع 2] فشل في العملية المتكاملة لإنشاء وتفعيل الكارت:`, error.message);
    throw error;
  }
}

module.exports = {
  generateCardCode,
  createCardOnlyBranch2,
  activateCardProfileViaScriptBranch2,
  processPaymentAndCreateCardBranch2
};
